      "id": "q1",
      "type": "free-text",
      "question": "What concrete problem does this change solve, and why does the new behavior solve it?",
      "required_concepts": ["design-intent"]
    },
    {
      "id": "q2",
      "type": "free-text",
      "question": "Describe one realistic failure or edge case for this change and how the code handles it.",

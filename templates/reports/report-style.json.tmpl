{
  "schema_version": "1.0",
  "mode": "plain-language-first",
  "rules": {
    "concrete_before_abstract": true,
    "define_term_on_first_use": true,
    "avoid_unnecessary_jargon": true,
    "explain_acronym_on_first_use": true,
    "max_new_terms_per_report": 3,
    "prefer_short_direct_sentences": true,
    "prefer_cause_and_effect": true,
    "prefer_examples_over_taxonomy": true
  },
  "preserve_exact": [
    "identifiers",
    "commands",
    "paths",
    "API names",
    "database objects",
    "status values",
    "verdicts"
  ]
}

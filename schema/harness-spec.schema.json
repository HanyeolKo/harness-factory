{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HanyeolKo/harness-factory/schema/harness-spec.schema.json",
  "title": "Harness Factory Runtime-neutral Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "runtime_targets",
    "limits",
    "domains",
    "agents",
    "skills",
    "orchestration",
    "evaluators",
    "approval_gates",
    "loops"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "profile": {"enum": ["core", "adaptive", "governed"]},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "root"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "purpose": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/relativePath"},
        "construction_receipt": {"$ref": "#/$defs/relativePath"}
      }
    },
    "runtime_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["claude", "codex", "gemini"]}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_parallelism", "max_delegation_depth"],
      "properties": {
        "max_parallelism": {"type": "integer", "minimum": 1},
        "max_delegation_depth": {"type": "integer", "minimum": 1},
        "max_instruction_lines": {"type": "integer", "minimum": 1},
        "target_markdown_lines": {"type": "integer", "minimum": 1, "maximum": 50, "default": 50},
        "max_markdown_lines": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100}
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_language", "report_language", "terminology"],
      "properties": {
        "artifact_language": {"const": "en", "description": "Language of canonical generated prose. Fixed to concise English to minimize runtime reading cost."},
        "report_language": {"$ref": "#/$defs/languageTag", "description": "Language tag that controls the grammar of user-facing reports only."},
        "terminology": {"enum": ["technical-english", "localized"], "description": "technical-english uses report_language grammar but preserves stable English technical nouns; localized translates explanatory technical nouns when a conventional local term exists. Both modes preserve identifiers, commands, paths, evidence, JSON keys, reasons, status values, and verdicts exactly."}
      },
      "default": {
        "artifact_language": "en",
        "report_language": "en",
        "terminology": "technical-english"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "coordinator"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}},
          "coordinator": {"$ref": "#/$defs/id"}
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "lane", "capabilities", "domains", "model_tier", "access"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "description": {"type": "string", "minLength": 1},
          "lane": {"enum": ["control", "execution", "evaluation", "improvement"]},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "domains": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "model_tier": {"enum": ["fast", "balanced", "deep"]},
          "access": {"enum": ["read-only", "workspace-write"]}
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "entry_agent", "domains", "instructions"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["entry", "evaluation", "verification", "harness-evaluation", "improvement", "domain"]},
          "entry_agent": {"$ref": "#/$defs/id"},
          "domains": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "instructions": {"$ref": "#/$defs/relativePath"},
          "evaluator": {"$ref": "#/$defs/id"}
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_skill", "handoffs"],
      "properties": {
        "entry_skill": {"$ref": "#/$defs/id"},
        "handoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "when", "artifacts"],
            "properties": {
              "from": {"$ref": "#/$defs/id"},
              "to": {"$ref": "#/$defs/id"},
              "when": {"type": "string", "minLength": 1},
              "artifacts": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}}
            }
          }
        }
      }
    },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "runner", "type", "command", "pass_condition"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "scope": {"enum": ["task", "harness"]},
          "owner": {"$ref": "#/$defs/id"},
          "runner": {"$ref": "#/$defs/id"},
          "type": {"enum": ["deterministic", "manual-deterministic", "rubric", "experiment"]},
          "command": {"type": "string", "minLength": 1},
          "pass_condition": {"type": "string", "minLength": 1}
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "owner", "required_action"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "trigger": {"type": "string", "minLength": 1},
          "owner": {"$ref": "#/$defs/id"},
          "required_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "policy", "max_document_lines"],
      "properties": {
        "index": {"$ref": "#/$defs/relativePath"},
        "policy": {"const": "preserve-and-reconcile"},
        "max_document_lines": {"type": "integer", "minimum": 1},
        "max_summary_chars": {"type": "integer", "minimum": 1}
      }
    },
    "loops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "evaluation", "fail_threshold"],
      "properties": {
        "execution": {"$ref": "#/$defs/relativePath"},
        "evaluation": {"$ref": "#/$defs/relativePath"},
        "improvement": {"$ref": "#/$defs/relativePath"},
        "improvement_owner": {"$ref": "#/$defs/id"},
        "fail_threshold": {"type": "integer", "minimum": 1},
        "retro_interval": {"type": "integer", "minimum": 1}
      }
    },
    "self_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "checker", "state", "evaluation_loop", "evaluator",
        "watched_paths", "targeted_suite",
        "targeted_sample_rate", "full_interval_units", "cooldown_units",
        "budget_ratio", "success_rate_drop_points", "cost_increase_ratio",
        "retry_threshold", "minimum_samples", "mandatory_events"
      ],
      "properties": {
        "mode": {"const": "event-driven"},
        "checker": {"$ref": "#/$defs/relativePath"},
        "state": {"$ref": "#/$defs/relativePath"},
        "evaluation_loop": {"$ref": "#/$defs/relativePath"},
        "evaluator": {"$ref": "#/$defs/id"},
        "watched_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "targeted_suite": {"$ref": "#/$defs/relativePath"},
        "targeted_sample_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "full_interval_units": {"type": "integer", "minimum": 1},
        "cooldown_units": {"type": "integer", "minimum": 0},
        "budget_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "success_rate_drop_points": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "cost_increase_ratio": {"type": "number", "minimum": 0},
        "retry_threshold": {"type": "integer", "minimum": 1},
        "minimum_samples": {"type": "integer", "minimum": 1},
        "mandatory_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {
        "not": {"required": ["profile"]},
        "required": ["memory", "self_evaluation"],
        "properties": {
          "harness": {"not": {"required": ["construction_receipt"]}},
          "limits": {
            "not": {
              "anyOf": [
                {"required": ["target_markdown_lines"]},
                {"required": ["max_markdown_lines"]}
              ]
            }
          },
          "loops": {"required": ["improvement", "improvement_owner"]},
          "skills": {"items": {"required": ["evaluator"]}},
          "evaluators": {"items": {"required": ["scope"]}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}},
      "then": {
        "not": {"required": ["profile"]},
        "properties": {
          "harness": {"not": {"required": ["construction_receipt"]}},
          "limits": {
            "not": {
              "anyOf": [
                {"required": ["target_markdown_lines"]},
                {"required": ["max_markdown_lines"]}
              ]
            }
          },
          "loops": {"required": ["improvement", "improvement_owner", "retro_interval"]}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {
        "required": ["profile", "communication"],
        "properties": {
          "harness": {"required": ["construction_receipt"]},
          "limits": {
            "required": [
              "max_instruction_lines",
              "target_markdown_lines",
              "max_markdown_lines"
            ]
          },
          "skills": {"items": {"required": ["evaluator"]}},
          "evaluators": {"items": {"required": ["scope"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.2"},
          "profile": {"const": "core"}
        },
        "required": ["schema_version", "profile"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["memory"]},
            {"required": ["self_evaluation"]}
          ]
        },
        "properties": {
          "agents": {
            "allOf": [
              {"contains": {"properties": {"capabilities": {"contains": {"const": "routing"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "execution"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "verification"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "verdict"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "defect-counting"}}}, "required": ["capabilities"]}}
            ],
            "items": {
              "properties": {
                "lane": {"not": {"const": "improvement"}},
                "capabilities": {"not": {"contains": {"const": "improvement"}}}
              }
            }
          },
          "loops": {
            "not": {
              "anyOf": [
                {"required": ["improvement"]},
                {"required": ["improvement_owner"]},
                {"required": ["retro_interval"]}
              ]
            }
          },
          "skills": {
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "entry"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "evaluation"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "verification"}}, "required": ["kind"]}},
              {"not": {"contains": {"properties": {"kind": {"enum": ["harness-evaluation", "improvement"]}}, "required": ["kind"]}}}
            ]
          },
          "evaluators": {
            "allOf": [
              {"contains": {"properties": {"scope": {"const": "task"}}, "required": ["scope"]}},
              {"not": {"contains": {"properties": {"scope": {"const": "harness"}}, "required": ["scope"]}}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.2"},
          "profile": {"enum": ["adaptive", "governed"]}
        },
        "required": ["schema_version", "profile"]
      },
      "then": {
        "required": ["memory", "self_evaluation"],
        "properties": {
          "agents": {
            "allOf": [
              {"contains": {"properties": {"capabilities": {"contains": {"const": "routing"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "execution"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "verification"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "verdict"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "defect-counting"}}}, "required": ["capabilities"]}},
              {"contains": {"properties": {"capabilities": {"contains": {"const": "improvement"}}}, "required": ["capabilities"]}}
            ]
          },
          "loops": {
            "required": ["improvement", "improvement_owner"],
            "not": {"required": ["retro_interval"]}
          },
          "skills": {
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "entry"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "evaluation"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "verification"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "harness-evaluation"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "improvement"}}, "required": ["kind"]}}
            ]
          },
          "evaluators": {
            "allOf": [
              {"contains": {"properties": {"scope": {"const": "task"}}, "required": ["scope"]}},
              {"contains": {"properties": {"scope": {"const": "harness"}}, "required": ["scope"]}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  }
}
